# Supabase Configuration
# Get these values from https://supabase.com/dashboard > Project Settings > API

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (for development and production)
VITE_SITE_URL=http://localhost:5173

# Optional: Google Analytics (if needed)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# VERCEL DEPLOYMENT NOTES
# ============================================
# When deploying to Vercel, add these as Environment Variables:
# 1. Go to Project Settings > Environment Variables
# 2. Add each variable above (without VITE_ prefix for Next.js, or with VITE_ for Vite)
# 3. Select appropriate environments (Production, Preview, Development)
# 4. Redeploy after adding variables
#
# For this Vite project, use VITE_ prefix
# For Next.js projects, use NEXT_PUBLIC_ prefix
