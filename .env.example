# =============================================================================
# HOGAR BELÉN - VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo a .env para desarrollo local
# En Vercel, configura estas variables en: Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUERIDO)
# -----------------------------------------------------------------------------
# Project: cgfpwlqnhgclzzaiqhwz
# Obtén estos valores en: https://supabase.com/dashboard/project/cgfpwlqnhgclzzaiqhwz/settings/api

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://cgfpwlqnhgclzzaiqhwz.supabase.co

# Clave anónima pública de Supabase (anon/public key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# SITE CONFIGURATION (REQUERIDO)
# -----------------------------------------------------------------------------

# URL del sitio en producción
VITE_SITE_URL=https://www.hogarbelen.org

# -----------------------------------------------------------------------------
# ANALYTICS (OPCIONAL)
# -----------------------------------------------------------------------------

# Google Analytics 4 - Measurement ID
# Obtén el ID en: https://analytics.google.com
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# NOTAS IMPORTANTES
# -----------------------------------------------------------------------------
# 1. Todas las variables DEBEN comenzar con VITE_ para ser accesibles en el frontend
# 2. NO compartas el archivo .env en Git (ya está en .gitignore)
# 3. En Vercel, configura estas variables en la sección "Environment Variables"
# 4. Las variables de entorno requieren un nuevo deploy para aplicarse en Vercel
# =============================================================================
