# ================================================
# HOGAR BELÉN - VARIABLES DE ENTORNO
# ================================================
# Copia este archivo como .env y completa los valores
# ================================================

# ================================================
# SUPABASE CONFIGURATION
# ================================================
# Obtén estos valores de: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ================================================
# OPENAI API (IMPORTANTE - SOLO SERVIDOR)
# ================================================
# ⚠️ NUNCA incluir en el frontend
# ⚠️ Configurar SOLO en Supabase Edge Functions
# ⚠️ O en variables de entorno del servidor backend
OPENAI_API_KEY=sk-proj-...

# ================================================
# META PIXEL (FACEBOOK ADS)
# ================================================
# Obtén tu Pixel ID de: https://business.facebook.com/events_manager
VITE_META_PIXEL_ID=tu_pixel_id_aqui

# ================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ================================================
VITE_APP_NAME=Hogar Belén
VITE_APP_URL=https://hogarbelen.org
VITE_APP_DOMAIN=hogarbelen.org

# ================================================
# WHATSAPP BUSINESS
# ================================================
VITE_WHATSAPP_NUMBER=573215708655
VITE_WHATSAPP_MESSAGE=Hola, me gustaría obtener más información sobre Hogar Belén

# ================================================
# CONTACTO Y ADMINISTRACIÓN
# ================================================
VITE_CONTACT_EMAIL=hogarbelen2022@gmail.com
VITE_CONTACT_PHONE=+573215708655
VITE_ADMIN_EMAIL=admin@hogarbelen.org

# ================================================
# GOOGLE ANALYTICS (OPCIONAL)
# ================================================
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ================================================
# CONFIGURACIÓN SEO
# ================================================
VITE_SITE_TITLE=Hogar Belén - Centro de Vida y Cuidado Integral para Adultos Mayores
VITE_SITE_DESCRIPTION=Centro de día y hogar geriátrico en Buesaco, Nariño. Cuidado profesional, actividades terapéuticas y turismo rural para adultos mayores.
VITE_SITE_KEYWORDS=hogar geriátrico Buesaco, centro vida adultos mayores Nariño, cuidado adulto mayor

# ================================================
# UBICACIÓN
# ================================================
VITE_LOCATION_ADDRESS=Buesaco, Nariño, Colombia
VITE_LOCATION_LAT=1.3724
VITE_LOCATION_LNG=-77.1551

# ================================================
# MODO DE DESARROLLO
# ================================================
# Opciones: development | production
NODE_ENV=development

# ================================================
# CONFIGURACIÓN DE SEGURIDAD
# ================================================
# Rate limiting para formularios (solicitudes por minuto)
VITE_RATE_LIMIT=10

# Tiempo de sesión en minutos
VITE_SESSION_TIMEOUT=60

# ================================================
# STORAGE (SUPABASE)
# ================================================
# Bucket para documentos de profesionales
VITE_STORAGE_BUCKET_DOCUMENTS=professional-documents

# Bucket para fotos de perfil
VITE_STORAGE_BUCKET_PROFILES=profile-photos

# Bucket para imágenes del sitio
VITE_STORAGE_BUCKET_IMAGES=site-images

# ================================================
# NOTAS IMPORTANTES
# ================================================
# 1. NO subir este archivo a Git con valores reales
# 2. Mantener .env en .gitignore
# 3. Para producción, usar variables de entorno del hosting
# 4. La API Key de OpenAI NUNCA debe estar en el frontend
# 5. Usar Supabase Edge Functions para llamadas a OpenAI
# ================================================
